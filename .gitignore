# Local configuration and credentials
.DS_Store
.env
.env.*
*.pem
*.key
__pycache__/
*.py[cod]
# Real records belong in a separate private workspace.
private/
local-data/
uploads/
*.eml
*.msg
*.pdf
*.xlsx

# These rules protect untracked attachments only. The tracked workspace CSV/MD
# and root dashboards are NOT protected by .gitignore; run the release check.
workspace/drafts/*
!workspace/drafts/.gitkeep
workspace/collaborations/*
!workspace/collaborations/.gitkeep
